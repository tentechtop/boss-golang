{
  "manifest_version": 3,
  "name": "AI 求职 Copilot",
  "version": "0.3.9",
  "description": "读取岗位内容，生成简历建议和沟通草稿，支持半自动批处理和人工确认发送。",
  "permissions": ["activeTab", "scripting", "tabs", "alarms", "storage", "notifications"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8083/*", "http://localhost:8083/*"],
      "js": ["bridge-client.js", "system-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.zhipin.com/*", "https://*.zhipin.com/*"],
      "js": ["bridge-client.js", "boss-search-policy.js", "boss-chat-policy.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
